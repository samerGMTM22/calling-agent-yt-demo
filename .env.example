# ─────────────────────────────────────────────────────────────────────────────
#  Calling Agent: settings template
#  1) Copy this file:   cp .env.example .env
#  2) Fill in YOUR values in .env (never in this file).
#  3) .env is git-ignored: it must NEVER be committed or shared.
#  Paste values WITHOUT quotes, e.g.  OPENAI_API_KEY=sk-proj-abc123
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: OpenAI (docs/en/01-openai.md) ──────────────────────────────────
OPENAI_API_KEY=

# ── Required: Twilio (docs/en/02-twilio.md) ──────────────────────────────────
# Account SID starts with AC… (Console home page → "Account Info").
TWILIO_ACCOUNT_SID=
# API key SID starts with SK…; the secret is shown only once when you create it.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Your Twilio phone number in E.164 format, e.g. +15551234567.
# Optional if the account has exactly one number.
TWILIO_PHONE_NUMBER=
# Optional but recommended: lets the server verify Twilio's webhook signatures.
# (Console → Account → API keys & tokens → Auth Token.) Leave empty to verify via API instead.
TWILIO_AUTH_TOKEN=

# ── Who the agent is ─────────────────────────────────────────────────────────
# The agent always introduces itself as "<AGENT_NAME>, <OWNER_NAME>'s AI agent".
AGENT_NAME=Sam
OWNER_NAME=Your Name
# auto = start in English and mirror the other person's language (Arabic works)
# ar   = start in Arabic        en = start in English
AGENT_LANGUAGE=auto
# Personality, tone, facts and house rules live in a plain-text file you can edit:
#   cp persona.example.md persona.md   (persona.md is git-ignored)
PERSONA_FILE=persona.md

# ── Security allowlists (E.164 format, comma separated) ──────────────────────
# Your own mobile number. Used as the default for both allowlists below.
OWNER_PHONE_NUMBER=
# Who may CALL the agent. Everyone else is rejected before the call is answered.
# Defaults to OWNER_PHONE_NUMBER. Use * only if you really want anyone to reach it.
ALLOWED_CALLERS=
# Who the agent may CALL. Defaults to ALLOWED_CALLERS.
# Add numbers on purpose; * means any number (not recommended).
ALLOWED_DESTINATIONS=
# Optional but recommended: a 4-10 digit PIN callers type on the keypad before the
# agent answers. Caller ID can be faked; a PIN cannot be guessed from your number.
INBOUND_PIN=

# ── Voice ────────────────────────────────────────────────────────────────────
# live     = GPT-Live (gpt-live-1): full-duplex, most natural, delegates thinking to the brain
# realtime = gpt-realtime-2.1: turn-based speech-to-speech, brain via function calling
VOICE_ENGINE=live
OPENAI_VOICE=marin
LIVE_MODEL=gpt-live-1
REALTIME_MODEL=gpt-realtime-2.1

# ── Brain: who answers when the voice delegates a question ──────────────────
# agent     = the AI agent running this repo answers live (npm run watch / npm run answer)
# openai    = an OpenAI reasoning model answers (OPENAI_BRAIN_MODEL)
# anthropic = Claude answers through the Anthropic API (needs ANTHROPIC_API_KEY)
# none      = the voice model handles everything alone
BRAIN_MODE=agent
# Used when BRAIN_MODE=agent and nobody answers in time.
BRAIN_FALLBACK=openai
BRAIN_TIMEOUT_SECONDS=30
OPENAI_BRAIN_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Local-only API for your agent. Never expose this port.
CONTROL_PORT=3001
# Leave empty to auto-detect a running ngrok tunnel. Or set your own https URL.
PUBLIC_URL=
# Optional: your free ngrok static domain (e.g. my-agent.ngrok-free.app) so the
# webhook URL never changes. Used by `npm run up`.
NGROK_DOMAIN=
# Hard cap on every call's length, in seconds (cost protection).
MAX_CALL_SECONDS=600
MAX_CONCURRENT_CALLS=2
# Save transcripts to ./calls (git-ignored). Set false to keep nothing on disk.
SAVE_TRANSCRIPTS=true
