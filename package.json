    "say": "node scripts/agent.js say",
    "note": "node scripts/agent.js note",
    "hangup": "node scripts/agent.js hangup",
    "calls": "node scripts/agent.js calls",
    "transcript": "node scripts/agent.js transcript",
    "status": "node scripts/agent.js status",
